variant: fcos
version: 1.4.0
storage:
  files:
    # YUM repository for kubeadm, kubelet and kubectl
    - path: /etc/yum.repos.d/kubernetes.repo
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [kubernetes]
          name=Kubernetes
          baseurl=https://pkgs.k8s.io/core:/stable:/v1.35/rpm/
          enabled=1
          gpgcheck=1
          gpgkey=https://pkgs.k8s.io/core:/stable:/v1.35/rpm/repodata/repomd.xml.key
    # YUM repository for CRI-O — keep the minor (v1.35) in lockstep with
    # kubernetes.repo above; bump BOTH together on a cluster minor upgrade.
    # cri-o packaging lives on the openSUSE Build Service (the old
    # pkgs.k8s.io/addons cri-o paths are deprecated and 403). Maintained stable
    # minors track Kubernetes (v1.34, v1.35, ...). Fedora's base cri-o (1.32) is
    # also present, so rpm-ostree resolves to the higher OBS version (1.35.x) on
    # the next re-layer. See github.com/cri-o/packaging.
    - path: /etc/yum.repos.d/cri-o.repo
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [cri-o]
          name=CRI-O
          baseurl=https://download.opensuse.org/repositories/isv:/cri-o:/stable:/v1.35/rpm/
          enabled=1
          gpgcheck=1
          gpgkey=https://download.opensuse.org/repositories/isv:/cri-o:/stable:/v1.35/rpm/repodata/repomd.xml.key
    # configuring automatic loading of br_netfilter on startup
    - path: /etc/modules-load.d/br_netfilter.conf
      mode: 0644
      overwrite: true
      contents:
        inline: br_netfilter
    # configuring automatic loading of ip_tables on startup
    # this is needed for wg container that use iptables
    - path: /etc/modules-load.d/ip_tables.conf
      mode: 0644
      overwrite: true
      contents:
        inline: ip_tables
    # setting kernel parameters required by kubelet
    - path: /etc/sysctl.d/kubernetes.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          net.bridge.bridge-nf-call-iptables=1
          net.ipv4.ip_forward=1
          kernel.softlockup_panic=1
          kernel.hardlockup_panic=1
    - path: /etc/sysctl.d/inotify.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          fs.inotify.max_user_instances=8192
          fs.inotify.max_user_watches=1048576
    # fixing perms for longhorn and SELinux
    # https://github.com/longhorn/longhorn/issues/4988
    # https://ioflair.com/blog/fix-longhorn-volumes-stuck-in-attach-detach-loop-on-openshift-okd/
    - path: /etc/ioflair/support/iscsiadm-fix.cil
      mode: 420
      contents:
        compression: ""
        source: data:,(allow%20iscsid_t%20self%20(capability%20(dac_override)))%0A
    # Zincati must keep checking and STAGING updates (rpm-ostree deploy --stage)
    # but should not reboot — kured is the sole authority for reboot timing.
    # zincati has no clean "never reboot" mode, so we use a periodic window
    # placed after kured's window (Sat/Sun 03:00–06:00 UTC) and so narrow it
    # never fires in practice. The bridge timer + kured handle all reboots.
    - path: /usr/local/bin/ostree-finalize-bridge.sh
      mode: 0755
      overwrite: true
      contents:
        inline: |
          #!/bin/bash
          # Zincati stages updates with finalization LOCKED (it never reboots —
          # kured does). A locked staged deployment is a no-op for the shutdown
          # ostree-finalize-staged.service, so kured's reboot would otherwise land
          # back on the old version. Unlock finalization here so the staged
          # deployment applies on the next shutdown, then signal kured to reboot.
          set -euo pipefail

          if rpm-ostree status --json \
                  | jq -e '.deployments[] | select(.staged == true)' > /dev/null 2>&1; then
            if ostree admin status | grep -q 'finalization locked'; then
              ostree admin lock-finalization --unlock
            fi
            touch /run/reboot-required
            exit 0
          fi

          # Fallback: a finalized-but-not-yet-booted (pending) deployment also
          # needs a reboot to take effect.
          if rpm-ostree status --json \
              | jq -e '.deployments[0] | (.booted == false and .staged == false)' \
              > /dev/null 2>&1; then
            touch /run/reboot-required
          fi
          exit 0
    - path: /etc/zincati/config.d/55-strategy.toml
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [[updates.periodic.window]]
          days = [ "Monday" ]
          start_time = "04:00"
          length_minutes = 1
systemd:
  units:
    - contents: |
        [Service]
        Type=oneshot
        ExecStart=/usr/sbin/semodule -i /etc/ioflair/support/iscsiadm-fix.cil
        RemainAfterExit=yes
        [Install]
        WantedBy=multi-user.target
      enabled: true
      name: iscsiadm-fix-selinux-policy.service
    # Reduce iSCSI replacement_timeout from 120s to 30s so that processes blocked
    # on a dropped Longhorn volume fail fast rather than freezing the node for 2
    # minutes during shutdown. 30s is still enough to survive transient blips on a
    # local LAN without triggering false I/O errors during replica rebuilds.
    - contents: |
        [Unit]
        Description=Set iSCSI replacement timeout for faster Longhorn failover
        ConditionPathExists=/etc/iscsi/iscsid.conf
        [Service]
        Type=oneshot
        ExecStart=/bin/sed -i 's/node.session.timeo.replacement_timeout = .*/node.session.timeo.replacement_timeout = 30/' /etc/iscsi/iscsid.conf
        RemainAfterExit=yes
        [Install]
        WantedBy=multi-user.target
      enabled: true
      name: iscsi-timeout-fix.service
    # Zincati stages updates but doesn't reboot; kured is the sole reboot
    # authority. This bridge runs every 15 min while the node is up. When a
    # staged deployment is detected it unlocks its finalization lock (via
    # `ostree admin lock-finalization --unlock`) so the deployment applies on
    # the next shutdown, then signals kured — so a single kured reboot lands
    # directly on the new OS. If the unlock fails the timer retries without
    # triggering a wasted reboot.
    - contents: |
        [Unit]
        Description=Finalize staged OS update and signal Kured to reboot
        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/ostree-finalize-bridge.sh
      name: zincati-kured-bridge.service
    - contents: |
        [Unit]
        Description=Periodically check for staged OS updates
        [Timer]
        OnBootSec=5min
        OnUnitActiveSec=15min
        [Install]
        WantedBy=timers.target
      enabled: true
      name: zincati-kured-bridge.timer
    # fstrim sends DISCARD to all mounted filesystems including Longhorn CSI
    # volumes, which causes device offline errors and node crashes.
    - name: fstrim.timer
      mask: true
passwd: # setting login credentials
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-rsa  kjvellajr@localhost.localdomain
